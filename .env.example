# Backend (Render / Railway) — required for Gemini voice
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Vercel frontend only — point to your Render WebSocket URL:
# WS_URL="wss://your-app.onrender.com/api/live"
# Or bake in at build time:
# VITE_WS_URL="wss://your-app.onrender.com/api/live"

APP_URL="https://your-frontend.vercel.app"
