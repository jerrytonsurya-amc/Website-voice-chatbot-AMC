# Required for Gemini Live API (set on your Node backend host, e.g. Render)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: where the app is hosted (embed / callbacks)
APP_URL="https://your-frontend.vercel.app"

# Required when frontend is on Vercel but voice API runs elsewhere (Render, Railway, etc.)
# Full WebSocket URL to the Live API bridge:
# VITE_WS_URL="wss://your-backend.onrender.com/api/live"
