{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:data && tsx scripts/dev.ts",
    "dev:api": "tsx scripts/local-api.ts",
    "dev:vite": "vite --port 5173",
    "dev:vercel": "npm run build:data && npm run build:api && vercel dev --listen 3000",
    "dev:server": "tsx server.ts",
    "build": "npm run build:web",
    "build:data": "tsx scripts/build-data.ts",
    "build:api": "tsx scripts/build-api.ts",
    "build:web": "npm run build:data && vite build",
    "start": "npx vercel dev --listen 3000",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "extract-knowledge": "tsx scripts/extract-knowledge.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "officeparser": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
